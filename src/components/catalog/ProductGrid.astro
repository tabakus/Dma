---
import type { Product } from '../../lib/products';
import ProductTile from './ProductTile.astro';

interface Props {
  products: Product[];
  /** Текст, если опубликованных продуктов нет. */
  emptyText: string;
}
const { products, emptyText } = Astro.props;
---

{
  products.length === 0 ? (
    <p class="catalog-empty">{emptyText}</p>
  ) : (
    <ul class="product-grid">
      {products.map((p) => (
        <li>
          <ProductTile product={p} />
        </li>
      ))}
    </ul>
  )
}

<style>
  .product-grid {
    list-style: none;
    margin: 0 0 var(--section-space);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: clamp(0.75rem, 0.5rem + 0.8vw, 1.25rem);
  }
</style>
