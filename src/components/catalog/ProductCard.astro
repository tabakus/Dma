---
import type { Product } from '../../lib/products';
import { hasPage, productUrl } from '../../lib/products';
import ProductFacts from '../product/ProductFacts.astro';

interface Props {
  product: Product;
}
const { product } = Astro.props;
---

<article class="product-card">
  <h3>
    {hasPage(product) ? <a href={productUrl(product)}>{product.data.title}</a> : product.data.title}
  </h3>
  {product.data.titleDe && <p lang="de">{product.data.titleDe}</p>}
  {hasPage(product) ? (
    <>
      {product.data.summary && <p>{product.data.summary}</p>}
      <ProductFacts product={product} />
    </>
  ) : (
    <p class="soon">Скоро</p>
  )}
</article>
