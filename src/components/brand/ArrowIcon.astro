---
/**
 * Стрелка «перейти» для круглых кнопок: геометрически по центру, толщина линии задаётся токеном цвета через currentColor.
 * Декоративная (aria-hidden): смысл передаёт текст ссылки или visually-hidden подпись рядом.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class:list={['arrow-icon', className]} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <path d="M4.5 12h14M13 6.5l5.5 5.5-5.5 5.5" />
</svg>

<style>
  .arrow-icon {
    width: 1.4rem;
    height: 1.4rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex: none;
  }
</style>
