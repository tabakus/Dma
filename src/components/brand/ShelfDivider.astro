---
/**
 * Разделитель между секциями — полка с кожаными корешками (src/assets/library/spines.jpg). Декоративный.
 */
import PhotoBackdrop from './PhotoBackdrop.astro';
import spines from '../../assets/library/spines.jpg';
---

<div class="shelf" aria-hidden="true">
  <PhotoBackdrop src={spines} class="shelf-bg" />
</div>

<style>
  .shelf {
    position: relative;
    isolation: isolate;
    height: clamp(5.5rem, 3rem + 9vw, 11rem);
    border-block: 1px solid var(--color-line);
    box-shadow: inset 0 14px 18px -12px #000, inset 0 -14px 18px -12px #000;
  }
  .shelf :global(.shelf-bg) { z-index: -1; }
  .shelf :global(.shelf-bg img) { object-position: 50% 55%; }
</style>
