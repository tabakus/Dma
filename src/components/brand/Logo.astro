---
/**
 * Утверждённый логотип Deutsch mit Akzent — концепция C «Structure & Accent».
 * Исходные SVG (текст в кривых) — src/assets/brand/. Логотип не перерисовывается и не меняется:
 * для другого фона выбирается вариант (variant), а не правятся цвета.
 */
import LogoLight from '../../assets/brand/logo-horizontal-light.svg';
import LogoDark from '../../assets/brand/logo-horizontal-dark.svg';
import { getSiteSettings } from '../../lib/site';

interface Props {
  /** light — для светлых фонов (по умолчанию), dark — для тёмных блоков. */
  variant?: 'light' | 'dark';
}
const { variant = 'light' } = Astro.props;
const site = await getSiteSettings();
const Svg = variant === 'dark' ? LogoDark : LogoLight;
---

<a class="logo" href="/" aria-label={`${site.name} — на главную`}>
  <Svg aria-hidden="true" focusable="false" />
</a>

<style>
  .logo {
    display: inline-block;
    line-height: 0;
  }
  .logo :global(svg) {
    width: auto;
    height: 2.5rem; /* 40 px */
    max-width: 100%;
  }
</style>
