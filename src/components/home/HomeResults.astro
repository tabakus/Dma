---
/**
 * Результат обучения — насыщенный блок цвета «переплёт» (бордовая кожа) с мягкой тенью к краям.
 * Тексты — home.yaml → results. Без обещаний уровня или «ноль ошибок».
 */
import type { HomeContent } from '../../lib/site';

interface Props {
  results: NonNullable<HomeContent['results']>;
}
const { results: r } = Astro.props;
---

<section class="results" aria-labelledby="results-title">
  <div class="container grid">
    <div class="head">
      {r.eyebrow && <p class="eyebrow">{r.eyebrow}</p>}
      <h2 id="results-title">{r.title}</h2>
      {r.note && <p class="note">{r.note}</p>}
    </div>
    <ul class="items">
      {r.items.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>

<style>
  .results {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 20% 0%, color-mix(in srgb, var(--color-gold) 14%, transparent), transparent 55%),
      radial-gradient(ellipse at 50% 50%, transparent 40%, color-mix(in srgb, var(--color-walnut-deep) 70%, transparent) 100%),
      var(--color-oxblood);
    color: var(--color-parchment);
    padding-block: var(--section-space);
    border-block: 1px solid var(--color-line);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }
  .head { display: grid; gap: var(--space-3); }
  .head > * { margin: 0; }
  .note { color: color-mix(in srgb, var(--color-parchment) 85%, transparent); }
  .items { list-style: none; margin: 0; padding: 0; display: grid; }
  .items li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: baseline;
    padding-block: clamp(1rem, 0.8rem + 0.6vw, 1.4rem);
    border-top: 1px solid var(--color-line);
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.45rem);
    line-height: 1.35;
  }
  .items li:last-child { border-bottom: 1px solid var(--color-line); }
  .items li::before {
    content: '';
    width: 0.6rem;
    height: 0.6rem;
    rotate: 45deg;
    background: var(--color-gold);
    translate: 0 -0.15em;
  }
  @media (max-width: 52rem) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
