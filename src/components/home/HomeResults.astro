---
/**
 * Результат обучения — тёмный блок (глубокий графит; на странице он один, кроме подвала).
 * Тексты — home.yaml → results. Без обещаний уровня или «ноль ошибок».
 */
import type { HomeContent } from '../../lib/site';

interface Props {
  results: NonNullable<HomeContent['results']>;
}
const { results: r } = Astro.props;
---

<section class="results" aria-labelledby="results-title">
  <div class="container grid">
    <div class="head">
      {r.eyebrow && <p class="eyebrow">{r.eyebrow}</p>}
      <h2 id="results-title">{r.title}</h2>
      {r.note && <p class="note">{r.note}</p>}
    </div>
    <ul class="items">
      {r.items.map((item) => <li>{item}</li>)}
    </ul>
  </div>
  <span class="orb" aria-hidden="true"></span>
</section>

<style>
  .results {
    position: relative;
    overflow: hidden;
    background: var(--color-ink);
    color: var(--color-milk);
    padding-block: var(--section-space);
  }
  .grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }
  .head { display: grid; gap: var(--space-3); }
  .head > * { margin: 0; }
  .eyebrow { color: color-mix(in srgb, var(--color-milk) 72%, transparent); }
  h2 { color: var(--color-milk); }
  .note { color: color-mix(in srgb, var(--color-milk) 80%, transparent); }
  .items { list-style: none; margin: 0; padding: 0; display: grid; }
  .items li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: baseline;
    padding-block: clamp(1rem, 0.8rem + 0.6vw, 1.4rem);
    border-top: 1px solid color-mix(in srgb, var(--color-milk) 16%, transparent);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.4rem);
    line-height: 1.35;
    font-weight: var(--weight-medium);
  }
  .items li:last-child { border-bottom: 1px solid color-mix(in srgb, var(--color-milk) 16%, transparent); }
  .items li::before {
    content: '';
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 2px;
    background: var(--color-accent);
    translate: 0 -0.1em;
  }
  /* фирменный круг уходит за край блока */
  .orb {
    position: absolute;
    left: -6rem;
    bottom: -8rem;
    width: clamp(14rem, 10rem + 14vw, 24rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-accent);
    opacity: 0.9;
  }
  @media (max-width: 52rem) {
    .grid { grid-template-columns: 1fr; }
    .orb { left: auto; right: -7rem; bottom: auto; top: -7rem; width: 14rem; }
  }
</style>
