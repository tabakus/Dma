---
/**
 * Результат обучения: читальный зал с лучом света (src/assets/library/reading-room.jpg) под тонировкой цвета
 * «переплёт» — луч проглядывает слева, под списком тонировка плотнее.
 * Тексты — home.yaml → results. Без обещаний уровня или «ноль ошибок».
 */
import reading from '../../assets/library/reading-room.jpg';
import PhotoBackdrop from '../brand/PhotoBackdrop.astro';
import type { HomeContent } from '../../lib/site';

interface Props {
  results: NonNullable<HomeContent['results']>;
}
const { results: r } = Astro.props;
---

<section class="results" aria-labelledby="results-title">
  <PhotoBackdrop src={reading} class="results-bg" />
  <div class="scrim" aria-hidden="true"></div>
  <div class="container grid">
    <div class="head">
      {r.eyebrow && <p class="eyebrow">{r.eyebrow}</p>}
      <h2 id="results-title">{r.title}</h2>
      {r.note && <p class="note">{r.note}</p>}
    </div>
    <ul class="items">
      {r.items.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>

<style>
  .results {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--color-oxblood);
    color: var(--color-parchment);
    padding-block: var(--section-space);
    border-block: 1px solid var(--color-line);
  }
  .results :global(.results-bg img) { object-position: 30% 50%; }
  .scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg,
      color-mix(in srgb, var(--color-oxblood) 62%, transparent) 0%,
      color-mix(in srgb, var(--color-oxblood) 78%, transparent) 40%,
      color-mix(in srgb, var(--color-oxblood) 90%, transparent) 60%);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }
  .head { display: grid; gap: var(--space-3); }
  .head > * { margin: 0; }
  .note { color: color-mix(in srgb, var(--color-parchment) 85%, transparent); }
  .items { list-style: none; margin: 0; padding: 0; display: grid; }
  .items li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: baseline;
    padding-block: clamp(1rem, 0.8rem + 0.6vw, 1.4rem);
    border-top: 1px solid var(--color-line);
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.45rem);
    line-height: 1.35;
  }
  .items li:last-child { border-bottom: 1px solid var(--color-line); }
  .items li::before {
    content: '';
    width: 0.6rem;
    height: 0.6rem;
    rotate: 45deg;
    background: var(--color-gold);
    translate: 0 -0.15em;
  }
  @media (max-width: 52rem) {
    .grid { grid-template-columns: 1fr; }
    .scrim { background: linear-gradient(180deg, color-mix(in srgb, var(--color-oxblood) 65%, transparent) 0%, color-mix(in srgb, var(--color-oxblood) 90%, transparent) 30%); }
  }
</style>
