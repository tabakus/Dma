---
/**
 * Методика: от отдельных правил — к системе. Тексты — home.yaml → method.
 * Фон — раскрытая книга под зелёной лампой (src/assets/library/desk-lamp.jpg): свет справа, тень слева под текстом.
 * Последовательность шагов (порядок — часть содержания, поэтому они пронумерованы).
 */
import type { HomeContent } from '../../lib/site';
import desk from '../../assets/library/desk-lamp.jpg';
import PhotoBackdrop from '../brand/PhotoBackdrop.astro';

interface Props {
  method: NonNullable<HomeContent['method']>;
}
const { method: m } = Astro.props;
---

<section class="method" aria-labelledby="method-title">
  <PhotoBackdrop src={desk} class="method-bg" />
  <div class="scrim" aria-hidden="true"></div>
  <div class="container">
    <div class="top">
      <div class="head">
        {m.eyebrow && <p class="eyebrow">{m.eyebrow}</p>}
        <h2 id="method-title">{m.title}</h2>
        {m.lead && <p class="lead">{m.lead}</p>}
      </div>
    </div>

    <ol class="steps">
      {
        m.steps.map((s, i) => (
          <li>
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .method {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: var(--section-space);
    color: var(--color-parchment);
  }
  .method :global(.method-bg img) { object-position: 70% 40%; }
  .scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, transparent 30%, color-mix(in srgb, var(--color-walnut) 90%, transparent) 64%, var(--color-walnut) 100%),
      linear-gradient(90deg, var(--color-walnut) 0%, color-mix(in srgb, var(--color-walnut) 85%, transparent) 30%, transparent 62%);
  }
  .top { min-height: clamp(14rem, 8rem + 18vw, 26rem); margin-bottom: clamp(2.5rem, 2rem + 3vw, 4.5rem); display: grid; align-content: start; }
  .head { display: grid; gap: var(--space-3); max-width: 32rem; }
  .head > * { margin: 0; }
  .lead { font-size: var(--text-lead); line-height: var(--leading-lead); color: var(--color-sepia); max-width: 34ch; }

  /* ---------- Шаги ---------- */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
    position: relative;
  }
  .steps li { position: relative; display: grid; gap: var(--space-2); align-content: start; padding-top: 1.75rem; }
  /* линия пути через все шаги */
  .steps li::before {
    content: '';
    position: absolute;
    top: 0.45rem;
    left: 0;
    right: calc(-1 * clamp(1.5rem, 1rem + 1.5vw, 2.5rem));
    height: 1px;
    background: var(--color-line);
  }
  .steps li:last-child::before { right: 0; background: linear-gradient(90deg, var(--color-line), var(--color-accent)); }
  .steps li::after {
    content: '';
    position: absolute;
    top: 0.05rem;
    left: 0;
    width: 0.8rem;
    height: 0.8rem;
    rotate: 45deg;
    background: var(--color-gold);
  }
  .steps li:last-child::after { rotate: 0deg; border-radius: 50%; background: var(--color-accent); }
  .num { font-family: var(--font-display); font-size: var(--text-small); color: var(--color-gold); }
  .steps h3 { margin: 0; font-size: var(--text-h4); line-height: var(--leading-h4); letter-spacing: 0; }
  .steps p { margin: 0; color: var(--color-sepia); font-size: var(--text-small); line-height: var(--leading-small); }

  @media (max-width: 60rem) {
    .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 2.5rem; }
    .steps li:nth-child(2n)::before { right: 0; }
  }
  /* Телефон: фото сверху над текстом, шаги идут вертикально, путь — линия слева */
  @media (max-width: 47.99rem) {
    .method { padding-top: 0; }
    .method :global(.method-bg) { bottom: auto; height: 20rem; }
    .method :global(.method-bg img) { object-position: 72% 40%; }
    .scrim { background: linear-gradient(180deg, transparent 0, transparent 8rem, var(--color-walnut) 19.5rem); }
    .top { min-height: 0; padding-top: 18rem; }
  }
  @media (max-width: 36rem) {
    .steps { grid-template-columns: 1fr; gap: 0; }
    .steps li { padding: 0 0 2rem 2.25rem; }
    .steps li::before { top: 1rem; bottom: 0; left: 0.4rem; right: auto; width: 1px; height: auto; }
    .steps li::after { top: 0.35rem; }
    .steps li:last-child { padding-bottom: 0; }
    .steps li:last-child::before { display: none; }
  }
</style>
