---
/**
 * Методика: от отдельных правил — к системе. Тексты — home.yaml → method.
 * Схема «до / после» и последовательность шагов (порядок шагов — часть содержания, поэтому они пронумерованы).
 */
import type { HomeContent } from '../../lib/site';

interface Props {
  method: NonNullable<HomeContent['method']>;
}
const { method: m } = Astro.props;
---

<section class="method" aria-labelledby="method-title">
  <div class="container">
    <div class="top">
      <div class="head">
        {m.eyebrow && <p class="eyebrow">{m.eyebrow}</p>}
        <h2 id="method-title">{m.title}</h2>
        {m.lead && <p class="lead">{m.lead}</p>}
      </div>

      <div class="diagram" aria-hidden="true">
        <div class="chaos">
          <i class="r1" /><i class="r2" /><i class="r3" /><i class="r4" /><i class="r5" /><i class="r6" />
        </div>
        <svg class="arrow" viewBox="0 0 80 24" focusable="false"><path d="M2 12h70m-10-9 10 9-10 9" /></svg>
        <div class="order">
          <i /><i /><i /><b />
        </div>
      </div>
    </div>

    <ol class="steps">
      {
        m.steps.map((s, i) => (
          <li>
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .method {
    background: var(--color-surface);
    padding-block: var(--section-space);
    border-block: 1px solid var(--color-line);
  }
  .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
    margin-bottom: clamp(2.5rem, 2rem + 3vw, 5rem);
  }
  .head { display: grid; gap: var(--space-3); }
  .head > * { margin: 0; }
  .lead { font-size: var(--text-lead); line-height: var(--leading-lead); color: var(--color-muted); max-width: 34ch; }

  /* ---------- Схема: хаос → система ---------- */
  .diagram {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: clamp(0.75rem, 0.5rem + 1vw, 1.5rem);
  }
  .chaos { position: relative; aspect-ratio: 1; }
  .chaos i {
    position: absolute;
    width: 30%;
    aspect-ratio: 1;
    border-radius: 4px;
    background: var(--color-sand);
    border: 1px solid var(--color-line);
  }
  .chaos .r1 { top: 4%; left: 8%; rotate: -14deg; background: var(--color-graphite); border: 0; }
  .chaos .r2 { top: 12%; left: 58%; rotate: 18deg; }
  .chaos .r3 { top: 40%; left: 30%; rotate: 32deg; background: var(--color-surface); }
  .chaos .r4 { top: 62%; left: 2%; rotate: 9deg; }
  .chaos .r5 { top: 66%; left: 62%; rotate: -22deg; background: var(--color-graphite); border: 0; }
  .chaos .r6 { top: 36%; left: 72%; rotate: -6deg; width: 18%; border-radius: 50%; background: var(--color-accent); border: 0; }
  .arrow { width: clamp(2.5rem, 2rem + 2vw, 4.5rem); height: auto; fill: none; stroke: var(--color-text); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .order {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10%;
    padding: 10%;
    aspect-ratio: 1;
  }
  .order i, .order b { border-radius: 4px; }
  .order i:nth-child(1) { background: var(--color-graphite); }
  .order i:nth-child(2) { background: var(--color-surface); border: 1px solid var(--color-line); }
  .order i:nth-child(3) { background: var(--color-sand); }
  .order b { background: var(--color-accent); border-radius: 50%; translate: 14% 6%; }

  /* ---------- Шаги ---------- */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
    position: relative;
  }
  .steps li { position: relative; display: grid; gap: var(--space-2); align-content: start; padding-top: 1.75rem; }
  /* линия пути через все шаги */
  .steps li::before {
    content: '';
    position: absolute;
    top: 0.45rem;
    left: 0;
    right: calc(-1 * clamp(1.5rem, 1rem + 1.5vw, 2.5rem));
    height: 2px;
    background: var(--color-line);
  }
  .steps li:last-child::before { right: 0; background: linear-gradient(90deg, var(--color-line), var(--color-accent)); }
  .steps li::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 1rem;
    height: 1rem;
    border-radius: 3px;
    background: var(--color-graphite);
  }
  .steps li:last-child::after { border-radius: 50%; background: var(--color-accent); }
  .num { font-size: var(--text-caption); font-weight: var(--weight-semibold); color: var(--color-link); letter-spacing: 0.04em; }
  .steps h3 { margin: 0; font-size: var(--text-h4); line-height: var(--leading-h4); letter-spacing: 0; }
  .steps p { margin: 0; color: var(--color-muted); font-size: var(--text-small); line-height: var(--leading-small); }

  @media (max-width: 60rem) {
    .top { grid-template-columns: 1fr; }
    .diagram { max-width: 30rem; }
    .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 2.5rem; }
    .steps li:nth-child(2n)::before { right: 0; }
  }
  /* Телефон: шаги идут вертикально, путь — линия слева */
  @media (max-width: 36rem) {
    .steps { grid-template-columns: 1fr; gap: 0; }
    .steps li { padding: 0 0 2rem 2.25rem; }
    .steps li::before { top: 1rem; bottom: 0; left: 0.45rem; right: auto; width: 2px; height: auto; }
    .steps li:last-child { padding-bottom: 0; }
    .steps li:last-child::before { display: none; }
  }
</style>
