---
/**
 * Раздел «Обучение» на главной (якорь #obuchenie). Заголовок — home.yaml → directions;
 * подразделы — src/data/directions.yaml, курсы и семинары — по полю direction.
 * Активный подраздел показывает колонки «Курсы» и «Семинары», подраздел в подготовке — короткую карточку.
 * В шапке каждого подраздела — заметная ссылка на пробный видеоурок.
 */
import ProductColumns from '../learning/ProductColumns.astro';
import TrialVideoLink from '../learning/TrialVideoLink.astro';
import { getDirections, withProducts } from '../../lib/directions';
import type { HomeContent } from '../../lib/site';

interface Props {
  directions: NonNullable<HomeContent['directions']>;
}
const { directions: head } = Astro.props;
const items = await Promise.all((await getDirections()).map(withProducts));
---

<section class="directions" id="obuchenie" aria-labelledby="directions-title">
  <div class="container">
    <div class="head">
      {head.eyebrow && <p class="eyebrow">{head.eyebrow}</p>}
      <h2 id="directions-title">{head.title}</h2>
      {head.intro && <p class="intro">{head.intro}</p>}
    </div>

    <div class="list">
      {
        items.map(({ direction, courses, seminars }) => {
          const d = direction.data;
          return (
            <article class:list={['panel', d.status]} aria-labelledby={`dir-${direction.id}`}>
              <header class="panel-head">
                <div class="titles">
                  <h3 id={`dir-${direction.id}`} lang="de">
                    <a href={d.path}>{d.title}</a>
                  </h3>
                  {d.subtitle && <p class="subtitle">{d.subtitle}</p>}
                </div>
                <TrialVideoLink direction={direction} />
              </header>

              {d.status === 'active' ? (
                <>
                  {d.lead && <p class="lead">{d.lead}</p>}
                  <ProductColumns courses={courses} seminars={seminars} title={d.formatsTitle} headingLevel={3} />
                  <a class="btn btn-secondary more" href={d.path}>
                    Подробнее о направлении <span aria-hidden="true">→</span>
                  </a>
                </>
              ) : (
                <div class="prep-body">
                  <p>{d.preparingText ?? 'Программа в подготовке'}</p>
                  <a class="link" href={d.path}>
                    Страница направления <span aria-hidden="true">→</span>
                  </a>
                </div>
              )}
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .directions {
    background: var(--color-bg-alt);
    padding-block: var(--section-space);
    scroll-margin-top: 4.5rem;
  }
  .head { display: grid; gap: var(--space-3); max-width: 46rem; margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.5rem); }
  .head .eyebrow, .head h2, .intro { margin: 0; }
  .intro { color: var(--color-muted); font-size: var(--text-lead); line-height: var(--leading-lead); }

  .list { display: grid; gap: clamp(1rem, 0.5rem + 1.5vw, 1.75rem); }
  .panel {
    position: relative;
    display: grid;
    gap: var(--space-4);
    padding: clamp(1.5rem, 1rem + 2vw, 3rem);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: calc(var(--radius) * 2);
    overflow: hidden;
  }
  /* фирменная геометрия в углу активного подраздела: модули и круг */
  .panel.active::before {
    content: '';
    position: absolute;
    top: -3.5rem;
    right: -3.5rem;
    width: 9rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-accent);
    opacity: 0.12;
    pointer-events: none;
  }
  .panel-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-4);
    position: relative;
  }
  .titles { display: grid; gap: 0.35rem; }
  .titles h3 {
    margin: 0;
    font-size: var(--text-h2);
    line-height: var(--leading-h2);
    letter-spacing: var(--tracking-h2);
  }
  .titles h3 a { color: var(--color-text); text-decoration: none; }
  .titles h3 a:hover { color: var(--color-link); }
  .subtitle { margin: 0; color: var(--color-muted); font-weight: var(--weight-medium); }
  .lead { margin: 0; max-width: 46rem; color: var(--color-muted); }
  .more { justify-self: start; }

  .prep-body { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-3); padding-top: var(--space-3); border-top: 1px solid var(--color-line); }
  .prep-body p { margin: 0; color: var(--color-muted); font-size: var(--text-lead); }
  .link { font-weight: var(--weight-semibold); text-decoration: none; }
  .link:hover { text-decoration: underline; }

  @media (max-width: 30rem) {
    .more { justify-self: stretch; }
  }
</style>
