---
/**
 * Раздел «Обучение» на главной (якорь #obuchenie): два прямоугольных блока-подраздела.
 * Слева — Deutsche Grammatik, справа — Sprachkurse für den Berufseinstieg. Весь блок — ссылка на страницу
 * подраздела; списки курсов и семинаров, видеоурок и подробности — уже там.
 * Заголовок раздела — home.yaml → directions; подразделы — src/data/directions.yaml.
 * Графика из языка логотипа: Grammatik — модули и круг (система), Berufseinstieg — ступени к кругу (путь в профессию).
 * Полоска и флажок в цветах флага Германии — у обоих подразделов (решение владельца 22.11.2026).
 * Фон — книжные полки в размытии (src/assets/library/shelves-bokeh.jpg); блоки — матовое стекло:
 * фон проглядывает, а плотная тонировка и размытие держат контраст текста (запасной вариант без backdrop-filter — плотнее).
 */
import { getDirections, withProducts } from '../../lib/directions';
import shelves from '../../assets/library/shelves-bokeh.jpg';
import PhotoBackdrop from '../brand/PhotoBackdrop.astro';
import ArrowIcon from '../brand/ArrowIcon.astro';
import type { HomeContent } from '../../lib/site';

interface Props {
  directions: NonNullable<HomeContent['directions']>;
}
const { directions: head } = Astro.props;
const items = await Promise.all((await getDirections()).map(withProducts));

/** Склонение: 1 курс, 2 курса, 5 курсов. */
function plural(n: number, one: string, few: string, many: string): string {
  const mod10 = n % 10;
  const mod100 = n % 100;
  if (mod10 === 1 && mod100 !== 11) return one;
  if (mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14)) return few;
  return many;
}
function countLine(courses: number, seminars: number): string | null {
  const parts = [
    courses > 0 ? `${courses} ${plural(courses, 'курс', 'курса', 'курсов')}` : null,
    seminars > 0 ? `${seminars} ${plural(seminars, 'семинар', 'семинара', 'семинаров')}` : null,
  ].filter(Boolean);
  return parts.length ? parts.join(' · ') : null;
}
---

<section class="directions" id="obuchenie" aria-labelledby="directions-title">
  <PhotoBackdrop src={shelves} />
  <div class="scrim" aria-hidden="true"></div>
  <div class="container">
    <div class="head">
      {head.eyebrow && <p class="eyebrow">{head.eyebrow}</p>}
      <h2 id="directions-title">{head.title}</h2>
      {head.intro && <p class="intro">{head.intro}</p>}
    </div>

    <div class="cards">
      {
        items.map(({ direction, courses, seminars }, i) => {
          const d = direction.data;
          const count = d.status === 'active' ? countLine(courses.length, seminars.length) : null;
          const variant = i === 0 ? 'system' : 'path';
          return (
            <a class:list={['card', variant, d.status]} href={d.path} aria-labelledby={`dir-${direction.id}`}>
              <span class="flagbar" aria-hidden="true" />
              <span class="art" aria-hidden="true">
                {variant === 'system' ? (
                  <span class="modules">
                    <i />
                    <i />
                    <i />
                    <b />
                  </span>
                ) : (
                  <span class="steps">
                    <i />
                    <i />
                    <i />
                    <b />
                  </span>
                )}
              </span>

              <span class="body">
                <span class="titles">
                  <h3 id={`dir-${direction.id}`} lang="de">
                    {d.title}
                  </h3>
                  {d.subtitle && (
                    <span class="subtitle">
                      <span class="flag-de" aria-hidden="true" />
                      {d.subtitle}
                    </span>
                  )}
                </span>
                {d.status === 'active' && d.lead && <span class="lead">{d.lead}</span>}
                <span class="foot">
                  {d.status === 'active' ? (
                    count && <span class="meta">{count}</span>
                  ) : (
                    <span class="pill">{d.preparingText ?? 'Программа в подготовке'}</span>
                  )}
                  <span class="go">
                    <span class="visually-hidden">Перейти к направлению</span>
                    <ArrowIcon />
                  </span>
                </span>
              </span>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .directions {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: var(--section-space);
    scroll-margin-top: 6.5rem;
    color: var(--color-parchment);
  }
  .scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, var(--color-walnut) 0%, transparent 20%, transparent 80%, var(--color-walnut) 100%),
      color-mix(in srgb, var(--color-walnut) 12%, transparent);
  }
  .head { display: grid; gap: var(--space-3); max-width: 46rem; margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.5rem); }
  .head .eyebrow, .head h2, .intro { margin: 0; }
  .head h2 { text-shadow: 0 2px 20px var(--color-walnut-deep); }
  .intro { color: var(--color-sepia); font-size: var(--text-lead); line-height: var(--leading-lead); }

  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 0.5rem + 1.5vw, 1.75rem);
  }

  /* ---------- Блок-подраздел: матовое стекло ---------- */
  .card {
    --tint: var(--color-walnut);
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: clamp(26rem, 20rem + 14vw, 34rem);
    padding: clamp(1.75rem, 1.25rem + 1.5vw, 2.75rem);
    border-radius: calc(var(--radius) * 3);
    overflow: hidden;
    color: var(--color-parchment);
    text-decoration: none;
    isolation: isolate;
    background: color-mix(in srgb, var(--tint) 86%, transparent);
    border: 1px solid var(--glass-border);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--color-parchment) 14%, transparent),
      0 40px 70px -40px #000;
    transition: transform 0.3s, border-color 0.3s, background-color 0.3s;
  }
  @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .card {
      background: color-mix(in srgb, var(--tint) 52%, transparent);
      backdrop-filter: blur(var(--glass-blur)) saturate(1.25);
      -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(1.25);
    }
  }
  /* лёгкий блик по верхнему краю стекла */
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(160deg, color-mix(in srgb, var(--color-parchment) 10%, transparent), transparent 40%);
    pointer-events: none;
  }
  .system { --tint: var(--color-oxblood); }
  .path { --tint: var(--color-emerald); }
  .card:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--color-gold) 75%, transparent); }
  .card:focus-visible { outline-offset: 4px; }

  .body { display: grid; gap: var(--space-3); align-content: end; position: relative; z-index: 1; }
  .titles { display: grid; gap: 0.4rem; }
  h3 {
    margin: 0;
    font-size: clamp(2rem, 1.3rem + 2.4vw, 3.25rem);
    font-weight: 560;
    line-height: 1.06;
    letter-spacing: var(--tracking-h1);
    color: var(--color-parchment);
    max-width: 13ch;
  }
  .subtitle { display: flex; align-items: center; gap: 0.55em; font-size: var(--text-lead); font-weight: var(--weight-medium); color: var(--color-gold-light); }
  /* полоска цветов флага по верхнему краю блока */
  .flagbar { position: absolute; z-index: 2; left: 0; right: 0; top: 0; height: 6px; background: var(--flag-stripes-h); box-shadow: inset 0 1px 0 var(--flag-edge); }
  .lead { max-width: 36ch; font-size: var(--text-small); line-height: var(--leading-small); color: color-mix(in srgb, var(--color-parchment) 88%, transparent); }

  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--glass-border);
  }
  .meta { font-size: var(--text-small); font-weight: var(--weight-semibold); letter-spacing: 0.01em; }
  .pill {
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-parchment) 14%, transparent);
    border: 1px solid var(--glass-border);
    color: var(--color-parchment);
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
  }
  .go {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--color-button-bg);
    color: var(--color-button-text);
    transition: transform 0.25s, background-color 0.2s, color 0.2s;
  }
  .card:hover .go { transform: translateX(4px); background: var(--color-button-bg-hover); color: var(--color-button-text-hover); }

  /* ---------- Графика: своя зона в верхней части блока, не пересекается с текстом ---------- */
  .art {
    display: flex;
    justify-content: flex-end;
    align-items: flex-start;
    height: clamp(8.5rem, 5rem + 7vw, 13rem);
    margin-bottom: var(--space-4);
    pointer-events: none;
  }
  /* Grammatik: модули 2×2 и круг, который выходит за сетку — система и индивидуальность */
  .modules {
    height: 100%;
    aspect-ratio: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 9%;
  }
  .modules i, .modules b { border-radius: 12%; transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .modules i:nth-child(1) { background: var(--color-parchment); }
  .modules i:nth-child(2) { border: 1.5px solid var(--color-gold); }
  .modules i:nth-child(3) { background: var(--color-gold); }
  .modules b { background: var(--color-accent); border-radius: 50%; transform: translate(12%, 8%); }
  .system:hover .modules b { transform: translate(26%, 18%); }
  .system:hover .modules i:nth-child(1) { transform: translate(-6%, -6%); }

  /* Berufseinstieg: ступени, ведущие к кругу — путь в профессию */
  .steps {
    height: 100%;
    aspect-ratio: 5 / 4;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: end;
    gap: 9%;
  }
  .steps i, .steps b { border-radius: 10%; transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .steps i:nth-child(1) { height: 32%; border: 1.5px solid var(--color-gold); }
  .steps i:nth-child(2) { height: 58%; background: var(--color-gold); }
  .steps i:nth-child(3) { height: 84%; background: var(--color-parchment); }
  .steps b { aspect-ratio: 1; align-self: start; border-radius: 50%; background: var(--color-accent); }
  .path:hover .steps b { transform: translateY(-14%); }
  .path:hover .steps i:nth-child(3) { transform: translateY(-4%); }

  /* ---------- Узкие экраны: блоки друг под другом, графика компактнее ---------- */
  @media (max-width: 52rem) {
    .cards { grid-template-columns: 1fr; }
    .card { min-height: 0; }
  }
  @media (max-width: 30rem) {
    .art { height: 7rem; margin-bottom: var(--space-3); }
    h3 { max-width: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .card:hover { transform: none; }
  }
</style>
