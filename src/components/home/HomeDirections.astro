---
/**
 * Два направления обучения (якорь #obuchenie). Тексты — home.yaml → directions.
 * Курс — структура (сетка модулей, квадрат); семинар — фокус на одной теме (круг).
 * Обе карточки белые: тип показывают метка, форма и графика, а не цвет фона (бренд-система v1.1).
 */
import type { HomeContent } from '../../lib/site';

interface Props {
  directions: NonNullable<HomeContent['directions']>;
}
const { directions: d } = Astro.props;
const cards = [
  { kind: 'course', ...d.courses },
  { kind: 'seminar', ...d.seminars },
] as const;
---

<section class="directions" id="obuchenie" aria-labelledby="directions-title">
  <div class="container">
    <div class="head">
      {d.eyebrow && <p class="eyebrow">{d.eyebrow}</p>}
      <h2 id="directions-title">{d.title}</h2>
      {d.intro && <p class="intro">{d.intro}</p>}
    </div>

    <div class="cards">
      {
        cards.map((c) => (
          <article class:list={['card', c.kind]} aria-labelledby={`dir-${c.kind}`}>
            <div class="art" aria-hidden="true">
              {c.kind === 'course' ? (
                <div class="grid9">
                  <i /><i /><i /><i /><i /><i /><i /><i /><b />
                </div>
              ) : (
                <div class="focus">
                  <b />
                </div>
              )}
            </div>
            <div class="body">
              <p class="type">
                <span class="mark" aria-hidden="true" />
                {c.kind === 'course' ? 'Курс' : 'Семинар'}
              </p>
              <h3 id={`dir-${c.kind}`}>{c.title}</h3>
              <p class="text">{c.text}</p>
              {c.points.length > 0 && (
                <ul class="points">
                  {c.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              )}
              <a class="btn btn-secondary" href={c.link.href}>
                {c.link.label} <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .directions {
    background: var(--color-bg-alt);
    padding-block: var(--section-space);
    scroll-margin-top: 4.5rem;
  }
  .head { display: grid; gap: var(--space-3); max-width: 46rem; margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.5rem); }
  .head .eyebrow, .head h2, .intro { margin: 0; }
  .intro { color: var(--color-muted); font-size: var(--text-lead); line-height: var(--leading-lead); }

  .cards {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(1rem, 0.5rem + 1.5vw, 1.75rem);
    align-items: stretch;
  }
  .card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: calc(var(--radius) * 2);
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 24px 40px -32px color-mix(in srgb, var(--color-ink) 55%, transparent);
  }
  .body { display: grid; gap: var(--space-3); align-content: start; padding: clamp(1.5rem, 1rem + 1.5vw, 2.5rem); }
  .body > * { margin: 0; }
  .type {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .mark { width: 0.8rem; height: 0.8rem; }
  .course .mark { background: var(--color-graphite); border-radius: 2px; }
  .seminar .mark { background: var(--color-accent); border-radius: 50%; }
  .text { color: var(--color-muted); max-width: 44ch; }
  .points { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; padding: 0; }
  .points li {
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    background: var(--color-bg);
    font-size: var(--text-caption);
    font-weight: var(--weight-medium);
  }
  .body .btn { justify-self: start; margin-top: var(--space-2); }

  /* ---------- Графика карточек ---------- */
  .art {
    height: clamp(9rem, 6rem + 8vw, 13rem);
    border-bottom: 1px solid var(--color-line);
    display: grid;
    align-items: center;
    padding-inline: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
  }
  .course .art { background: var(--color-bg); }
  .grid9 {
    display: grid;
    grid-template-columns: repeat(9, 1fr);
    gap: 0.6rem;
    width: min(100%, 30rem);
  }
  .grid9 i, .grid9 b { aspect-ratio: 1; border-radius: 3px; }
  .grid9 i { background: var(--color-graphite); }
  .grid9 i:nth-child(even) { background: var(--color-surface); border: 1px solid var(--color-line); }
  .grid9 i:nth-child(3n) { background: var(--color-sand); border: 0; }
  .grid9 b { background: var(--color-accent); border-radius: 50%; translate: 25% -25%; }

  .seminar .art { background: var(--color-mist); overflow: hidden; position: relative; }
  .focus { position: relative; height: 100%; }
  .focus b {
    position: absolute;
    right: -2rem;
    top: 50%;
    width: clamp(9rem, 6rem + 9vw, 14rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-accent);
    translate: 0 -50%;
  }
  .focus::before {
    /* один модуль — одна тема */
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: clamp(2.5rem, 2rem + 1.5vw, 3.5rem);
    aspect-ratio: 1;
    border-radius: 4px;
    background: var(--color-graphite);
    translate: 0 -50%;
  }

  @media (max-width: 52rem) {
    .cards { grid-template-columns: 1fr; }
  }
  @media (max-width: 30rem) {
    .body .btn { justify-self: stretch; }
    .grid9 { gap: 0.4rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .card:hover { transform: none; }
  }
</style>
