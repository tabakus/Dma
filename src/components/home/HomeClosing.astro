---
/**
 * Финальный призыв: слоган крупной типографикой и переходы к обучению. Тексты — home.yaml → closing.
 * Графика — модули, поднимающиеся ступенями к кругу: путь и прогресс.
 */
import { sentences } from '../../lib/text';
import type { HomeContent } from '../../lib/site';

interface Props {
  closing: NonNullable<HomeContent['closing']>;
}
const { closing: c } = Astro.props;
const lines = sentences(c.title);
---

<section class="closing" aria-labelledby="closing-title">
  <div class="container grid">
    <div class="copy">
      <h2 id="closing-title" lang="de">
        {lines.map((line, i) => <span class:list={['line', { accent: i === lines.length - 1 && lines.length > 1 }]}>{line}</span>)}
      </h2>
      {c.text && <p class="text">{c.text}</p>}
      {
        c.links.length > 0 && (
          <div class="actions">
            {c.links.map((l, i) => (
              <a class:list={['btn', i === 0 ? 'btn-primary' : 'btn-secondary']} href={l.href}>
                {l.label}
              </a>
            ))}
          </div>
        )
      }
    </div>
    <div class="steps" aria-hidden="true">
      <i></i><i></i><i></i><b></b>
    </div>
  </div>
</section>

<style>
  .closing { padding-block: var(--section-space); overflow: hidden; }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: end;
  }
  .copy { display: grid; gap: var(--space-4); }
  h2 {
    margin: 0;
    font-size: clamp(2.5rem, 1.5rem + 4.4vw, 5.25rem);
    line-height: 1.02;
    letter-spacing: var(--tracking-h1);
  }
  .line { display: block; }
  .accent { color: var(--color-accent); }
  .text { margin: 0; font-size: var(--text-lead); line-height: var(--leading-lead); color: var(--color-muted); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }

  /* ступени к кругу */
  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: end;
    gap: 6%;
    width: min(100%, 24rem);
    aspect-ratio: 4 / 3;
    justify-self: end;
  }
  .steps i, .steps b { border-radius: 4px; }
  .steps i:nth-child(1) { height: 25%; background: var(--color-sand); }
  .steps i:nth-child(2) { height: 50%; background: var(--color-surface); border: 1px solid var(--color-line); }
  .steps i:nth-child(3) { height: 75%; background: var(--color-graphite); }
  .steps b { aspect-ratio: 1; align-self: start; border-radius: 50%; background: var(--color-accent); translate: 0 -20%; }
  @media (max-width: 48rem) {
    .grid { grid-template-columns: 1fr; }
    .steps { justify-self: start; width: min(100%, 16rem); order: -1; }
  }
  @media (max-width: 30rem) {
    .actions { flex-direction: column; }
    .actions .btn { width: 100%; }
  }
</style>
