---
/**
 * Финальный призыв: слоган крупной типографикой и переходы к обучению. Тексты — home.yaml → closing.
 * Фон — рабочий стол в библиотеке (src/assets/library/desk-still-life.jpg): тетрадь, перо, кофе — приглашение начать.
 * Слева под текстом — плотная тень, натюрморт справа остаётся видимым.
 */
import desk from '../../assets/library/desk-still-life.jpg';
import PhotoBackdrop from '../brand/PhotoBackdrop.astro';
import { sentences } from '../../lib/text';
import type { HomeContent } from '../../lib/site';

interface Props {
  closing: NonNullable<HomeContent['closing']>;
}
const { closing: c } = Astro.props;
const lines = sentences(c.title);
---

<section class="closing" aria-labelledby="closing-title">
  <PhotoBackdrop src={desk} class="closing-bg" />
  <div class="scrim" aria-hidden="true"></div>
  <div class="container grid">
    <div class="copy">
      <h2 id="closing-title" lang="de">
        {lines.map((line, i) => <span class:list={['line', { accent: i === lines.length - 1 && lines.length > 1 }]}>{line}</span>)}
      </h2>
      {c.text && <p class="text">{c.text}</p>}
      {
        c.links.length > 0 && (
          <div class="actions">
            {c.links.map((l, i) => (
              <a class:list={['btn', i === 0 ? 'btn-primary' : 'btn-on-dark']} href={l.href}>
                {l.label}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .closing {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: calc(var(--section-space) * 1.2);
    color: var(--color-parchment);
  }
  .closing :global(.closing-bg img) { object-position: 70% 60%; }
  .scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, var(--color-walnut) 0%, transparent 30%, transparent 70%, var(--color-walnut-deep) 100%),
      linear-gradient(90deg, color-mix(in srgb, var(--color-walnut) 96%, transparent) 0%, color-mix(in srgb, var(--color-walnut) 86%, transparent) 45%, color-mix(in srgb, var(--color-walnut) 30%, transparent) 80%, color-mix(in srgb, var(--color-walnut) 20%, transparent) 100%);
  }
  .grid { display: grid; }
  .copy { display: grid; gap: var(--space-4); max-width: 46rem; }
  h2 {
    margin: 0;
    font-size: clamp(2.5rem, 1.5rem + 4.4vw, 5.25rem);
    font-weight: 520;
    line-height: 1.04;
    letter-spacing: var(--tracking-h1);
  }
  .line { display: block; }
  .accent { color: var(--color-accent); }
  .text { margin: 0; font-size: var(--text-lead); line-height: var(--leading-lead); color: var(--color-sepia); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  @media (max-width: 47.99rem) {
    .closing :global(.closing-bg img) { object-position: 75% 60%; }
    .scrim { background: color-mix(in srgb, var(--color-walnut) 84%, transparent); }
  }
  @media (max-width: 30rem) {
    .actions { flex-direction: column; }
    .actions .btn { width: 100%; }
  }
</style>
