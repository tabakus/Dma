---
/**
 * Первый экран главной. Тексты — home.yaml → hero.
 * Фон — девушка с ноутбуком и книгами в старинной библиотеке (сгенерировано владельцем, 22.11.2026):
 * на компьютере она справа, слева глубокая тень под текст; на телефоне — вертикальный кадр, девушка внизу.
 * Вокруг головы оставлено место под будущую инфографику (фразы). Файлы: hero-reader-hd.png (десктоп, 1678 px, без потерь),
 * hero-reader-tall.jpg (телефон; логотип ноутбука удалён ретушью). Прежний кадр hero-reader.jpg сохранён по просьбе владельца.
 */
import heroWide from '../../assets/library/hero-reader-hd.png';
import heroTall from '../../assets/library/hero-reader-tall.jpg';
import PhotoBackdrop from '../brand/PhotoBackdrop.astro';
import { splitAccent } from '../../lib/text';
import type { HomeContent } from '../../lib/site';

interface Props {
  hero: HomeContent['hero'];
}
const { hero } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <PhotoBackdrop src={heroWide} mobile={heroTall} eager quality={88} alt={hero.imageAlt} class="hero-bg" />
  <div class="scrim" aria-hidden="true"></div>
  <div class="container grid">
    <div class="copy">
      {hero.eyebrow && <p class="eyebrow">{hero.eyebrow}</p>}
      <h1 id="hero-title">
        {splitAccent(hero.title).map((p) => (p.accent ? <span class="accent">{p.text}</span> : p.text))}
      </h1>
      {hero.lead && <p class="lead">{hero.lead}</p>}
      <div class="actions">
        {hero.primaryCta && <a class="btn btn-primary" href={hero.primaryCta.href}>{hero.primaryCta.label}</a>}
        {
          hero.secondaryLinks.length > 0 && (
            <ul class="more" aria-label="Разделы обучения">
              {hero.secondaryLinks.map((l) => (
                <li>
                  <a href={l.href}>
                    {l.label} <span aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    align-items: center;
    min-height: min(92svh, 58rem);
    padding-block: clamp(3rem, 1.5rem + 6vw, 7rem) clamp(4rem, 2rem + 6vw, 8rem);
    color: var(--color-parchment);
  }
  .hero :global(.hero-bg) { z-index: -2; }
  .hero :global(.hero-bg img) { object-position: 62% 40%; }
  /* Затемнение: глубокая тень слева под текстом, девушка и окно справа остаются в свету; снизу — переход к следующей секции */
  .scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, transparent 70%, var(--color-walnut) 100%),
      linear-gradient(90deg,
        color-mix(in srgb, var(--color-walnut) 92%, transparent) 0%,
        color-mix(in srgb, var(--color-walnut) 78%, transparent) 34%,
        color-mix(in srgb, var(--color-walnut) 20%, transparent) 52%,
        transparent 64%);
  }
  .grid { display: grid; position: relative; z-index: 1; }
  .copy { display: grid; gap: var(--space-4); min-width: 0; max-width: min(38rem, 46vw); }
  .copy .eyebrow { margin: 0; }
  h1 {
    margin: 0;
    max-width: 14ch;
    font-size: clamp(2.6rem, 1.6rem + 3.6vw, 4.6rem);
    font-weight: 560;
    line-height: 1.04;
    text-shadow: 0 2px 24px color-mix(in srgb, var(--color-walnut-deep) 70%, transparent);
  }
  .accent { color: var(--color-accent); }
  .lead {
    margin: 0;
    max-width: 36ch;
    font-size: var(--text-lead);
    line-height: var(--leading-lead);
    color: var(--color-sepia);
  }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-5); margin-top: var(--space-2); }
  .more { display: flex; gap: var(--space-4); list-style: none; margin: 0; padding: 0; }
  .more a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: var(--tap-min);
    color: var(--color-gold);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    white-space: nowrap;
  }
  .more a:hover { border-bottom-color: currentColor; }
  .more a span { transition: transform 0.15s; }
  .more a:hover span { transform: translateX(3px); }

  /* Первое появление: текст проступает из тени */
  .copy { animation: emerge 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  @keyframes emerge { from { opacity: 0; transform: translateY(12px); } }
  @media (prefers-reduced-motion: reduce) {
    .copy { animation: none; }
  }

  /* ---------- Планшет: девушка правее, текст шире ---------- */
  @media (max-width: 60rem) {
    .hero :global(.hero-bg img) { object-position: 82% 40%; }
    .copy { max-width: min(30rem, 58vw); }
  }
  /* ---------- Телефон: текст сверху, под ним вертикальный кадр целиком — лицо девушки ниже текста ---------- */
  @media (max-width: 47.99rem) {
    .hero {
      align-items: start;
      min-height: 0;
      padding-block: 2rem 112vw;
    }
    /* кадр 768×1376 по ширине экрана: высота ≈ 179vw, прижат к низу секции */
    .hero :global(.hero-bg) { top: auto; height: 179vw; }
    .hero :global(.hero-bg img) { object-position: 50% 100%; }
    .scrim {
      background: linear-gradient(0deg,
        var(--color-walnut) 0%,
        transparent 10vw,
        transparent 98vw,
        color-mix(in srgb, var(--color-walnut) 88%, transparent) 124vw,
        var(--color-walnut) 150vw);
    }
    .copy { max-width: none; }
  }
  @media (max-width: 30rem) {
    .actions { flex-direction: column; align-items: stretch; gap: var(--space-2); }
    .actions .btn { width: 100%; }
    .more { justify-content: space-between; }
  }
</style>
