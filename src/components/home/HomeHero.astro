---
/**
 * Первый экран главной. Тексты — home.yaml → hero.
 * Справа — фотография (девушка в библиотеке, задумалась над книгами) во фрейме с фирменными
 * акцентами: графитовый модуль и розовый круг из языка логотипа. Позже на фото добавятся текстовые эффекты.
 * Фото: Pexels, photo 8085255 (лицензия Pexels), файл src/assets/home/hero-library.jpg.
 */
import { Image } from 'astro:assets';
import heroPhoto from '../../assets/home/hero-library.jpg';
import { splitAccent } from '../../lib/text';
import type { HomeContent } from '../../lib/site';

interface Props {
  hero: HomeContent['hero'];
}
const { hero } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container grid">
    <div class="copy">
      {hero.eyebrow && <p class="eyebrow">{hero.eyebrow}</p>}
      <h1 id="hero-title">
        {splitAccent(hero.title).map((p) => (p.accent ? <span class="accent">{p.text}</span> : p.text))}
      </h1>
      {hero.lead && <p class="lead">{hero.lead}</p>}
      <div class="actions">
        {hero.primaryCta && <a class="btn btn-primary" href={hero.primaryCta.href}>{hero.primaryCta.label}</a>}
        {
          hero.secondaryLinks.length > 0 && (
            <ul class="more" aria-label="Разделы обучения">
              {hero.secondaryLinks.map((l) => (
                <li>
                  <a href={l.href}>
                    {l.label} <span aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>

    <figure class="photo">
      <span class="accent-square" aria-hidden="true"></span>
      <Image
        src={heroPhoto}
        alt={hero.imageAlt ?? ''}
        widths={[480, 720, 960, 1280]}
        sizes="(max-width: 60rem) 92vw, 40vw"
        loading="eager"
        fetchpriority="high"
        class="img"
      />
      <span class="accent-circle" aria-hidden="true"></span>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 1rem + 6vw, 6.5rem) clamp(3.5rem, 2rem + 6vw, 7.5rem);
    overflow: hidden;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }
  .copy { display: grid; gap: var(--space-4); min-width: 0; }
  .copy .eyebrow { margin: 0; }
  h1 { margin: 0; max-width: 14ch; }
  .accent { color: var(--color-accent); }
  .lead {
    margin: 0;
    max-width: 36ch;
    font-size: var(--text-lead);
    line-height: var(--leading-lead);
    color: var(--color-muted);
  }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-5); margin-top: var(--space-2); }
  .more { display: flex; gap: var(--space-4); list-style: none; margin: 0; padding: 0; }
  .more a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: var(--tap-min);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  .more a:hover { border-bottom-color: currentColor; }
  .more a span { transition: transform 0.15s; }
  .more a:hover span { transform: translateX(3px); }

  /* ---------- Фото ---------- */
  .photo {
    position: relative;
    margin: 0;
    width: min(100%, 30rem);
    justify-self: center;
    isolation: isolate;
  }
  .img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 45% 22%;
    border-radius: calc(var(--radius) * 3);
    box-shadow: 0 40px 60px -45px color-mix(in srgb, var(--color-ink) 70%, transparent);
    animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  /* графитовый модуль за фото — «система» */
  .accent-square {
    position: absolute;
    z-index: -1;
    left: -1.5rem;
    top: -1.5rem;
    width: 42%;
    aspect-ratio: 1;
    border-radius: calc(var(--radius) * 1.5);
    background: var(--color-graphite);
  }
  /* розовый круг выходит за край фото — «Akzent», как в логотипе */
  .accent-circle {
    position: absolute;
    right: -1.75rem;
    bottom: 12%;
    width: 28%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-accent);
    animation: pop 0.7s 0.35s cubic-bezier(0.2, 0.7, 0.2, 1.2) both;
  }
  @keyframes rise { from { transform: translateY(16px); } }
  @keyframes pop { from { transform: scale(0.6); } }
  @media (prefers-reduced-motion: reduce) {
    .img, .accent-circle { animation: none; }
  }

  /* ---------- Планшет ---------- */
  @media (max-width: 60rem) {
    .grid { grid-template-columns: 1fr; }
    h1 { max-width: 16ch; }
    .photo { width: min(100%, 26rem); justify-self: start; margin-left: 1.5rem; }
  }
  /* ---------- Телефон: компактная графика, меньше «правил», кнопка на всю ширину ---------- */
  @media (max-width: 30rem) {
    .actions { flex-direction: column; align-items: stretch; gap: var(--space-2); }
    .actions .btn { width: 100%; }
    .more { justify-content: space-between; }
    .photo { width: calc(100% - 2.5rem); margin-left: 1rem; }
    .img { aspect-ratio: 5 / 4; object-position: 45% 18%; }
    .accent-square { left: -1rem; top: -1rem; }
    .accent-circle { right: -1.25rem; width: 24%; }
  }
</style>
