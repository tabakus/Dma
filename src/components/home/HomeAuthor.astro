---
/**
 * Преподаватель (якорь #avtor). Тексты — home.yaml → author.
 * Светлая «страница» (пергамент); место для фото оформлено как портрет в раме.
 * Фото, имя и биография пока не предоставлены: показывается аккуратное место для фотографии.
 * Ничего не выдумывается: имя и ссылка появляются, только когда заданы в home.yaml.
 */
import type { HomeContent } from '../../lib/site';

interface Props {
  author: NonNullable<HomeContent['author']>;
}
const { author: a } = Astro.props;
---

<section class="author paper" id="avtor" aria-labelledby="author-title">
  <div class="container grid">
    <div class="photo" role="img" aria-label={a.photoPlaceholder ?? 'Место для фотографии преподавателя'}>
      <span class="mark" aria-hidden="true"><i></i><i></i><i></i><b></b></span>
      {a.photoPlaceholder && <span class="caption" aria-hidden="true">{a.photoPlaceholder}</span>}
    </div>
    <div class="body">
      {a.eyebrow && <p class="eyebrow">{a.eyebrow}</p>}
      <h2 id="author-title">{a.name ?? a.title}</h2>
      {a.name && <p class="role">{a.title}</p>}
      {a.text && <p class="text">{a.text}</p>}
      {
        a.link && (
          <a class="btn btn-secondary" href={a.link.href}>
            {a.link.label} <span aria-hidden="true">→</span>
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .author { padding-block: var(--section-space); scroll-margin-top: 6.5rem; }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 6fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }
  .photo {
    position: relative;
    aspect-ratio: 4 / 5;
    max-width: 22rem;
    width: 100%;
    background:
      radial-gradient(ellipse at 50% 35%, var(--color-walnut-raised), var(--color-walnut) 75%);
    border: 1px solid var(--color-gold);
    outline: 1px solid color-mix(in srgb, var(--color-gold) 55%, transparent);
    outline-offset: -0.6rem;
    box-shadow: 0 0 0 0.55rem var(--color-walnut), 0 0 0 calc(0.55rem + 1px) var(--color-gold), 0 40px 60px -30px color-mix(in srgb, var(--color-umber) 80%, transparent);
    margin: 0.6rem;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .mark { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; width: 30%; }
  .mark i, .mark b { aspect-ratio: 1; border-radius: 3px; }
  .mark i:nth-child(1) { background: var(--color-parchment); }
  .mark i:nth-child(2) { border: 1px solid var(--color-gold); }
  .mark i:nth-child(3) { background: var(--color-gold); }
  .mark b { background: var(--color-accent); border-radius: 50%; }
  .caption {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 1.5rem;
    text-align: center;
    font-size: var(--text-caption);
    color: var(--color-sepia);
  }
  .body { display: grid; gap: var(--space-3); max-width: 38rem; }
  .body > * { margin: 0; }
  .role { color: var(--color-muted); font-weight: var(--weight-medium); }
  .text { font-family: var(--font-display); font-size: var(--text-lead); line-height: var(--leading-lead); }
  .body .btn { justify-self: start; margin-top: var(--space-2); }
  @media (max-width: 48rem) {
    .grid { grid-template-columns: 1fr; }
    .photo { max-width: 15rem; aspect-ratio: 1; }
  }
</style>
