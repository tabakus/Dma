---
/**
 * Преподаватель (якорь #avtor). Тексты — home.yaml → author.
 * Фото, имя и биография пока не предоставлены: показывается аккуратное место для фотографии.
 * Ничего не выдумывается: имя и ссылка появляются, только когда заданы в home.yaml.
 */
import type { HomeContent } from '../../lib/site';

interface Props {
  author: NonNullable<HomeContent['author']>;
}
const { author: a } = Astro.props;
---

<section class="author" id="avtor" aria-labelledby="author-title">
  <div class="container grid">
    <div class="photo" role="img" aria-label={a.photoPlaceholder ?? 'Место для фотографии преподавателя'}>
      <span class="mark" aria-hidden="true"><i></i><i></i><i></i><b></b></span>
      {a.photoPlaceholder && <span class="caption" aria-hidden="true">{a.photoPlaceholder}</span>}
    </div>
    <div class="body">
      {a.eyebrow && <p class="eyebrow">{a.eyebrow}</p>}
      <h2 id="author-title">{a.name ?? a.title}</h2>
      {a.name && <p class="role">{a.title}</p>}
      {a.text && <p class="text">{a.text}</p>}
      {
        a.link && (
          <a class="btn btn-secondary" href={a.link.href}>
            {a.link.label} <span aria-hidden="true">→</span>
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .author { padding-block: var(--section-space); background: var(--color-bg-alt); scroll-margin-top: 4.5rem; }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 6fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }
  .photo {
    position: relative;
    aspect-ratio: 4 / 5;
    max-width: 24rem;
    width: 100%;
    border-radius: calc(var(--radius) * 2);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .mark { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; width: 34%; }
  .mark i, .mark b { aspect-ratio: 1; border-radius: 4px; }
  .mark i:nth-child(1) { background: var(--color-graphite); }
  .mark i:nth-child(2) { background: var(--color-sand); }
  .mark i:nth-child(3) { background: var(--color-sand); }
  .mark b { background: var(--color-accent); border-radius: 50%; }
  .caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1.25rem;
    text-align: center;
    font-size: var(--text-caption);
    color: var(--color-muted);
  }
  .body { display: grid; gap: var(--space-3); max-width: 38rem; }
  .body > * { margin: 0; }
  .role { color: var(--color-muted); font-weight: var(--weight-medium); }
  .text { font-size: var(--text-lead); line-height: var(--leading-lead); }
  .body .btn { justify-self: start; margin-top: var(--space-2); }
  @media (max-width: 48rem) {
    .grid { grid-template-columns: 1fr; }
    .photo { max-width: 16rem; aspect-ratio: 1; }
  }
</style>
