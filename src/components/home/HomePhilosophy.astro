---
/**
 * Философия бренда: ошибки — нормальная часть обучения. Тексты — home.yaml → philosophy.
 * Светлая «страница» (класс paper): пергамент на тёмном фоне сайта.
 * Пример исправления показывает идею «Akzent» на живом немецком предложении.
 */
import type { HomeContent } from '../../lib/site';

interface Props {
  philosophy: NonNullable<HomeContent['philosophy']>;
}
const { philosophy: p } = Astro.props;
---

<section class="philosophy paper" aria-label="Наш подход к ошибкам">
  <div class="container grid">
    <p class="statement">{p.statement}</p>
    <div class="side">
      {p.text && <p class="text">{p.text}</p>}
      {
        p.example && (
          <figure class="example">
            <p class="wrong" lang="de">
              <span class="visually-hidden">Неверно: </span>
              <s>{p.example.wrong}</s>
            </p>
            <p class="right" lang="de">
              <span class="visually-hidden">Верно: </span>
              {p.example.right}
            </p>
            {p.example.note && <figcaption>{p.example.note}</figcaption>}
          </figure>
        )
      }
    </div>
  </div>
</section>

<style>
  .philosophy { padding-block: var(--section-space); }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: end;
  }
  .statement {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 520;
    font-optical-sizing: auto;
    color: var(--color-heading);
    font-size: clamp(2.25rem, 1.4rem + 3.6vw, 4.5rem);
    line-height: 1.04;
    letter-spacing: var(--tracking-h1);
    text-wrap: balance;
  }
  .side { display: grid; gap: var(--space-4); }
  .text { margin: 0; font-size: var(--text-lead); line-height: var(--leading-lead); color: var(--color-muted); }
  .example {
    margin: 0;
    padding: var(--space-4);
    border-left: 3px solid var(--color-oxblood);
    background: color-mix(in srgb, var(--color-surface) 70%, transparent);
    box-shadow: 0 18px 30px -24px color-mix(in srgb, var(--color-umber) 60%, transparent);
    border-radius: 0 var(--radius) var(--radius) 0;
    display: grid;
    gap: 0.4rem;
  }
  .example p { margin: 0; font-size: var(--text-body); }
  .wrong { color: var(--color-muted); }
  .wrong s { text-decoration-color: var(--color-accent); text-decoration-thickness: 2px; }
  .example .right { font-family: var(--font-display); font-size: var(--text-lead); font-weight: var(--weight-semibold); }
  .example figcaption { margin-top: 0.4rem; font-size: var(--text-caption); color: var(--color-muted); }
  @media (max-width: 52rem) {
    .grid { grid-template-columns: 1fr; align-items: start; }
  }
</style>
