---
/**
 * Страница курса или семинара (общий шаблон для /kurse/<папка>/ и /seminare/<папка>/).
 * Сверху — название (сначала немецкое, под ним русское) и ключевые данные на фоне стола с лампой; справа — матовая панель со стоимостью,
 * характеристиками и кнопкой «Записаться». Ниже — авторский текст (index.md) на пергаменте и форма заявки.
 * Показываются только заполненные поля; ничего не подставляется.
 */
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ApplicationForm from '../forms/ApplicationForm.astro';
import PhotoBackdrop from '../brand/PhotoBackdrop.astro';
import ProductFacts from './ProductFacts.astro';
import desk from '../../assets/library/desk-lamp.jpg';
import { productType, productUrl, type Product } from '../../lib/products';
import { getDirection } from '../../lib/directions';
import { productJsonLd } from '../../lib/structured-data';
import { formatPrice } from '../../lib/format';
import { getSiteSettings } from '../../lib/site';

interface Props {
  product: Product;
}
const { product } = Astro.props;
const { Content } = await render(product);
const { locale } = await getSiteSettings();
const d = product.data;
const type = productType(product);
const direction = await getDirection(d.direction);
const url = new URL(productUrl(product), Astro.site).href;
const kindLabel = type === 'course' ? 'Курс' : 'Семинар';
---

<BaseLayout
  title={d.seo?.title ?? d.title}
  description={d.seo?.description ?? d.summary}
  ogType="article"
  ogImage={d.cover?.src}
  jsonLd={productJsonLd(product, url)}
  fullBleed
>
  <section class="intro" aria-labelledby="product-title">
    <PhotoBackdrop src={desk} eager class="intro-bg" />
    <div class="scrim" aria-hidden="true"></div>
    <div class="container grid">
      <div class="copy">
        <p class="back">
          <a href={direction.data.path}><span aria-hidden="true">←</span> <span lang="de">{direction.data.title}</span></a>
        </p>
        <p class="eyebrow">{kindLabel}</p>
        {
          d.titleDe ? (
            <>
              <h1 id="product-title" lang="de">{d.titleDe}</h1>
              <p class="sub">{d.title}</p>
            </>
          ) : (
            <h1 id="product-title">{d.title}</h1>
          )
        }
        {d.summary && <p class="lead">{d.summary}</p>}
      </div>

      <aside class="panel" aria-label="Стоимость и условия">
        {
          d.price !== undefined && (
            <p class="price">
              <span class="price-label">Стоимость</span>
              <span class="price-value">{formatPrice(d.price, d.currency, locale)}</span>
            </p>
          )
        }
        <ProductFacts product={product} hidePrice />
        <a class="btn btn-primary signup" href="#zayavka">Записаться</a>
      </aside>
    </div>
  </section>

  <section class="body paper" aria-label="Описание">
    <div class="container">
      <div class="prose">
        <Content />
      </div>
    </div>
  </section>

  <section class="signup-section" id="zayavka">
    <div class="container">
      <div class="form-panel">
        <ApplicationForm productType={type} productSlug={product.id} productTitle={d.title} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Верх: название и панель условий ---------- */
  .intro {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(1.5rem, 1rem + 2vw, 3rem) clamp(3rem, 2rem + 4vw, 5.5rem);
    color: var(--color-parchment);
  }
  .intro :global(.intro-bg img) { object-position: 75% 40%; }
  .scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, transparent 55%, var(--color-walnut) 100%),
      linear-gradient(90deg, var(--color-walnut) 0%, color-mix(in srgb, var(--color-walnut) 85%, transparent) 45%, color-mix(in srgb, var(--color-walnut) 45%, transparent) 100%);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: end;
  }
  .copy { display: grid; gap: var(--space-3); }
  .copy > * { margin: 0; }
  .back a { color: var(--color-gold); text-decoration: none; display: inline-flex; gap: 0.4rem; min-height: 2.75rem; align-items: center; font-weight: var(--weight-medium); }
  .back a:hover { text-decoration: underline; }
  .copy .eyebrow { margin-top: var(--space-3); }
  h1 { font-size: var(--text-h1); font-weight: 560; line-height: var(--leading-h1); text-shadow: 0 2px 24px var(--color-walnut-deep); }
  .sub { font-family: var(--font-display); font-size: var(--text-h4); color: var(--color-gold-light); }
  .lead { max-width: 40ch; font-size: var(--text-lead); line-height: var(--leading-lead); color: var(--color-parchment); }

  .panel {
    display: grid;
    gap: var(--space-4);
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
    border-radius: calc(var(--radius) * 3);
    border: 1px solid var(--glass-border);
    background: color-mix(in srgb, var(--color-oxblood) 88%, transparent);
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--color-parchment) 12%, transparent), 0 40px 70px -40px #000;
  }
  @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .panel {
      background: color-mix(in srgb, var(--color-oxblood) 62%, transparent);
      backdrop-filter: blur(var(--glass-blur)) saturate(1.2);
      -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(1.2);
    }
  }
  .price { display: grid; gap: 0.2rem; margin: 0; padding-bottom: var(--space-3); border-bottom: 1px solid var(--glass-border); }
  .price-label { font-size: var(--text-small); color: var(--color-gold-light); }
  .price-value { font-family: var(--font-display); font-size: clamp(2.25rem, 1.8rem + 1.6vw, 3rem); font-weight: 560; line-height: 1; }
  .signup { width: 100%; }

  /* ---------- Описание на пергаменте ---------- */
  .body { padding-block: clamp(3rem, 2rem + 4vw, 5.5rem); }
  .prose { max-width: 42rem; }
  .prose :global(h2) { font-size: var(--text-h2); margin: 2.5rem 0 1rem; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(h3) { font-size: var(--text-h4); margin: 2rem 0 0.75rem; }
  .prose :global(p) { margin: 0 0 1rem; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 1rem; padding-left: 1.4rem; }
  .prose :global(li) { margin-bottom: 0.45rem; }
  .prose :global(li::marker) { color: var(--color-oxblood); }
  .prose :global(ol) { list-style: none; padding: 0; counter-reset: lesson; }
  .prose :global(ol > li) {
    counter-increment: lesson;
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    gap: 0.5rem;
    padding: 0.7rem 0;
    margin: 0;
    border-top: 1px solid var(--color-line);
  }
  .prose :global(ol > li:last-child) { border-bottom: 1px solid var(--color-line); }
  .prose :global(ol > li::before) {
    content: counter(lesson);
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    color: var(--color-oxblood);
  }
  .prose :global(strong) { font-weight: var(--weight-semibold); }

  /* ---------- Заявка ---------- */
  .signup-section { padding-block: clamp(3rem, 2rem + 4vw, 5.5rem) var(--section-space); scroll-margin-top: 6.5rem; }
  .form-panel {
    max-width: 40rem;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2.5rem);
    border-radius: calc(var(--radius) * 3);
    border: 1px solid var(--color-line);
    background: var(--color-walnut-raised);
  }

  @media (max-width: 56rem) {
    .grid { grid-template-columns: 1fr; align-items: start; }
    .panel { max-width: 30rem; }
  }
  @media (max-width: 47.99rem) {
    .scrim { background: linear-gradient(180deg, color-mix(in srgb, var(--color-walnut) 75%, transparent) 0%, color-mix(in srgb, var(--color-walnut) 88%, transparent) 50%, var(--color-walnut) 100%); }
  }
</style>
