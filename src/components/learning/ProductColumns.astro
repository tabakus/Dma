---
/**
 * Курсы и семинары подраздела — группы матовых мини-блоков (ProductTile).
 * Опубликованный продукт открывает свою страницу (описание, план, стоимость, заявка);
 * анонс показан с пометкой «Скоро» без ссылки.
 */
import ProductTile from '../catalog/ProductTile.astro';
import type { Course, Seminar, Product } from '../../lib/products';

interface Props {
  courses: Course[];
  seminars: Seminar[];
  /** Фраза над группами, например «Два формата — одна система». */
  title?: string;
}
const { courses, seminars, title } = Astro.props;
const groups: { kind: 'course' | 'seminar'; label: string; items: Product[] }[] = [
  { kind: 'course', label: 'Курсы', items: courses },
  { kind: 'seminar', label: 'Семинары', items: seminars },
];
---

<div class="formats">
  {title && <h2 class="formats-title">{title}</h2>}
  {
    groups.map((g) => (
      <section class:list={['group', g.kind]} aria-labelledby={`group-${g.kind}`}>
        <h3 class="group-title" id={`group-${g.kind}`}>
          <span class="mark" aria-hidden="true" />
          {g.label}
        </h3>
        {g.items.length === 0 ? (
          <p class="empty">Программа в подготовке</p>
        ) : (
          <ul class="tiles">
            {g.items.map((p) => (
              <li>
                <ProductTile product={p} headingLevel={4} />
              </li>
            ))}
          </ul>
        )}
      </section>
    ))
  }
</div>

<style>
  .formats { display: grid; gap: clamp(2rem, 1.5rem + 2vw, 3rem); }
  .formats-title {
    margin: 0;
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
    text-shadow: 0 2px 16px var(--color-walnut-deep);
  }
  .group { display: grid; gap: var(--space-3); }
  .group-title {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0;
    font-size: var(--text-h4);
    text-shadow: 0 2px 16px var(--color-walnut-deep);
  }
  .mark { width: 0.7rem; height: 0.7rem; flex: none; }
  .course .mark { background: var(--color-gold); rotate: 45deg; }
  .seminar .mark { background: var(--color-accent); border-radius: 50%; }
  .tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: clamp(0.75rem, 0.5rem + 0.8vw, 1.25rem);
  }
  .empty { margin: 0; color: var(--color-sepia); }
</style>
