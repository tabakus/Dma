---
/**
 * Две колонки подраздела: «Курсы» и «Семинары».
 * Опубликованный продукт — ссылка на свою страницу (описание, план, стоимость, заявка);
 * анонс — название без ссылки с пометкой «Скоро».
 */
import { hasPage, productUrl, type Course, type Seminar, type Product } from '../../lib/products';

interface Props {
  courses: Course[];
  seminars: Seminar[];
  /** Фраза над колонками, например «Два формата — одна система». */
  title?: string;
  /** Уровень заголовка фразы и колонок: на главной h3/h4, на странице подраздела h2/h3. */
  headingLevel?: 2 | 3;
}
const { courses, seminars, title, headingLevel = 3 } = Astro.props;
const Title = `h${headingLevel}` as 'h2' | 'h3';
const ColTitle = `h${headingLevel + 1}` as 'h3' | 'h4';
const columns: { kind: 'course' | 'seminar'; label: string; items: Product[] }[] = [
  { kind: 'course', label: 'Курсы', items: courses },
  { kind: 'seminar', label: 'Семинары', items: seminars },
];
---

<div class="formats">
  {title && <Title class="formats-title">{title}</Title>}
  <div class="columns">
    {
      columns.map((col) => (
        <div class:list={['col', col.kind]}>
          <ColTitle class="col-title">
            <span class="mark" aria-hidden="true" />
            {col.label}
          </ColTitle>
          {col.items.length === 0 ? (
            <p class="empty">Программа в подготовке</p>
          ) : (
            <ul>
              {col.items.map((p) => (
                <li>
                  {hasPage(p) ? (
                    <a class="item" href={productUrl(p)}>
                      <span class="names">
                        <span class="ru">{p.data.title}</span>
                        {p.data.titleDe && <span class="de" lang="de">{p.data.titleDe}</span>}
                      </span>
                      <span class="go" aria-hidden="true">→</span>
                    </a>
                  ) : (
                    <div class="item soon">
                      <span class="names">
                        <span class="ru">{p.data.title}</span>
                        {p.data.titleDe && <span class="de" lang="de">{p.data.titleDe}</span>}
                      </span>
                      <span class="badge">Скоро</span>
                    </div>
                  )}
                </li>
              ))}
            </ul>
          )}
        </div>
      ))
    }
  </div>
</div>

<style>
  .formats { display: grid; gap: var(--space-4); }
  .formats-title {
    margin: 0;
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
    letter-spacing: var(--tracking-h3);
  }
  .columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 1rem + 2vw, 3rem);
  }
  .col-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.5rem;
    font-size: var(--text-h4);
    font-weight: var(--weight-semibold);
    color: var(--color-heading);
  }
  .mark { width: 0.8rem; height: 0.8rem; flex: none; }
  .course .mark { background: var(--color-mark); border-radius: 2px; width: 0.65rem; height: 0.65rem; rotate: 45deg; }
  .seminar .mark { background: var(--color-accent); border-radius: 50%; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { border-top: 1px solid var(--color-line); }
  li:last-child { border-bottom: 1px solid var(--color-line); }
  .item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: var(--tap-min);
    padding-block: 0.85rem;
    color: var(--color-text);
    text-decoration: none;
  }
  a.item:hover .ru { color: var(--color-link); }
  a.item:hover .go { transform: translateX(3px); }
  .names { display: grid; gap: 0.15rem; min-width: 0; }
  .ru { font-weight: var(--weight-semibold); line-height: 1.3; transition: color 0.15s; }
  .de { font-size: var(--text-caption); color: var(--color-muted); line-height: 1.35; }
  .go { color: var(--color-link); font-weight: var(--weight-semibold); transition: transform 0.15s; }
  .badge {
    flex: none;
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    background: var(--color-bg-alt);
    color: var(--color-muted);
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.02em;
    border: 1px solid var(--color-line);
  }
  .empty { margin: 0; padding-block: 0.85rem; color: var(--color-muted); border-top: 1px solid var(--color-line); }
  @media (max-width: 44rem) {
    .columns { grid-template-columns: 1fr; }
  }
</style>
