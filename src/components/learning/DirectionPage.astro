---
/**
 * Страница подраздела обучения. Оформление — как у прежнего списка на главной (утверждено владельцем),
 * в теме «Старинная библиотека»: панель-пергамент на фоне книжных полок в размытии, крупное название, ссылка на пробный видеоурок справа вверху,
 * фраза «Два формата — одна система» и колонки «Курсы» / «Семинары» (или «Программа в подготовке»).
 * Ниже — место пробного видеоурока (#probeurok). Данные — src/data/directions.yaml и курсы/семинары с полем direction.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductColumns from './ProductColumns.astro';
import TrialVideoLink from './TrialVideoLink.astro';
import VideoPlaceholder from './VideoPlaceholder.astro';
import { getDirection, withProducts } from '../../lib/directions';
import PhotoBackdrop from '../brand/PhotoBackdrop.astro';
import shelves from '../../assets/library/shelves-bokeh.jpg';

interface Props {
  id: string;
}
const direction = await getDirection(Astro.props.id);
const { courses, seminars } = await withProducts(direction);
const d = direction.data;
---

<BaseLayout title={d.title} description={d.lead ?? d.subtitle} fullBleed>
  <section class="program" aria-labelledby="direction-title">
    <PhotoBackdrop src={shelves} eager />
    <div class="scrim" aria-hidden="true"></div>
    <div class="container">
      <p class="eyebrow back"><a href="/#obuchenie"><span aria-hidden="true">←</span> Обучение</a></p>

      <article class:list={['panel', 'paper', d.status]}>
        <header class="panel-head">
          <div class="titles">
            <h1 id="direction-title" lang="de">{d.title}</h1>
            {d.subtitle && <p class="subtitle">{d.subtitle}</p>}
          </div>
          <TrialVideoLink direction={direction} />
        </header>

        {
          d.status === 'active' ? (
            <>
              {d.lead && <p class="lead">{d.lead}</p>}
              <ProductColumns courses={courses} seminars={seminars} title={d.formatsTitle} headingLevel={2} />
            </>
          ) : (
            <div class="prep-body">
              <p>{d.preparingText ?? 'Программа в подготовке'}</p>
            </div>
          )
        }
      </article>
    </div>
  </section>

  <VideoPlaceholder direction={direction} />
</BaseLayout>

<style>
  .program {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(2rem, 1rem + 3vw, 4rem) var(--section-space);
  }
  .scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, transparent 70%, var(--color-walnut) 100%),
      color-mix(in srgb, var(--color-walnut) 35%, transparent);
  }
  .back { margin: 0 0 var(--space-4); }
  .back::before { display: none; }
  .back a { color: var(--color-gold); text-decoration: none; display: inline-flex; gap: 0.4rem; min-height: 2.75rem; align-items: center; }
  .back a:hover { text-decoration: underline; }

  .panel {
    position: relative;
    display: grid;
    gap: var(--space-4);
    padding: clamp(1.5rem, 1rem + 2vw, 3rem);
    border: 1px solid var(--color-gold);
    border-radius: calc(var(--radius) * 2);
    box-shadow: 0 50px 80px -40px #000;
    overflow: hidden;
  }
  /* фирменная геометрия в углу: круг-акцент */
  .panel.active::before {
    content: '';
    position: absolute;
    top: -3.5rem;
    right: -3.5rem;
    width: 9rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-oxblood);
    opacity: 0.1;
    pointer-events: none;
  }
  .panel-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-4);
    position: relative;
  }
  .titles { display: grid; gap: 0.35rem; }
  .titles h1 {
    margin: 0;
    font-size: var(--text-h1);
    font-weight: 560;
    line-height: var(--leading-h2);
    letter-spacing: var(--tracking-h2);
  }
  .subtitle { margin: 0; color: var(--color-muted); font-weight: var(--weight-medium); }
  .lead { margin: 0; max-width: 46rem; color: var(--color-muted); }

  .prep-body { padding-top: var(--space-3); border-top: 1px solid var(--color-line); }
  .prep-body p { margin: 0; color: var(--color-muted); font-size: var(--text-lead); }
</style>
