---
/**
 * Страница подраздела обучения: шапка с заметной ссылкой на пробный видеоурок,
 * колонки «Курсы» и «Семинары» (или «Программа в подготовке») и место видеоурока.
 * Данные — src/data/directions.yaml и курсы/семинары с полем direction.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductColumns from './ProductColumns.astro';
import TrialVideoLink from './TrialVideoLink.astro';
import VideoPlaceholder from './VideoPlaceholder.astro';
import { getDirection, withProducts } from '../../lib/directions';

interface Props {
  id: string;
}
const direction = await getDirection(Astro.props.id);
const { courses, seminars } = await withProducts(direction);
const d = direction.data;
---

<BaseLayout title={d.title} description={d.lead ?? d.subtitle} fullBleed>
  <header class="head">
    <div class="container inner">
      <div class="text">
        <p class="eyebrow"><a href="/#obuchenie">Обучение</a></p>
        <h1 lang="de">{d.title}</h1>
        {d.subtitle && <p class="subtitle">{d.subtitle}</p>}
        {d.lead && <p class="lead">{d.lead}</p>}
      </div>
      <div class="trial"><TrialVideoLink direction={direction} /></div>
    </div>
  </header>

  <section class="program" aria-label="Программа">
    <div class="container">
      {
        d.status === 'active' ? (
          <ProductColumns courses={courses} seminars={seminars} title={d.formatsTitle} headingLevel={2} />
        ) : (
          <p class="preparing">{d.preparingText ?? 'Программа в подготовке'}</p>
        )
      }
    </div>
  </section>

  <VideoPlaceholder direction={direction} />
</BaseLayout>

<style>
  .head {
    background: var(--color-bg-alt);
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem);
    border-bottom: 1px solid var(--color-line);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4) var(--space-5);
  }
  .text { display: grid; gap: var(--space-3); max-width: 44rem; }
  .text > * { margin: 0; }
  .eyebrow a { color: inherit; text-decoration: none; }
  .eyebrow a:hover { color: var(--color-link); }
  .subtitle { font-size: var(--text-lead); font-weight: var(--weight-medium); }
  .lead { color: var(--color-muted); font-size: var(--text-body); max-width: 40rem; }
  .program { padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) 0; }
  .preparing {
    margin: 0;
    padding: var(--space-5) var(--space-4);
    border: 1px dashed var(--color-line);
    border-radius: calc(var(--radius) * 2);
    text-align: center;
    font-size: var(--text-lead);
    color: var(--color-muted);
  }
</style>
