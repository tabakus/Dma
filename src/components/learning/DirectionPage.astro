---
/**
 * Страница подраздела обучения на фоне книжных полок в размытии: крупное название, ссылка на пробный видеоурок,
 * фраза «Два формата — одна система» и группы матовых мини-блоков «Курсы» / «Семинары»
 * (или «Программа в подготовке»).
 * Ниже — место пробного видеоурока (#probeurok). Данные — src/data/directions.yaml и курсы/семинары с полем direction.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductColumns from './ProductColumns.astro';
import TrialVideoLink from './TrialVideoLink.astro';
import VideoPlaceholder from './VideoPlaceholder.astro';
import { getDirection, withProducts } from '../../lib/directions';
import PhotoBackdrop from '../brand/PhotoBackdrop.astro';
import shelves from '../../assets/library/shelves-bokeh.jpg';

interface Props {
  id: string;
}
const direction = await getDirection(Astro.props.id);
const { courses, seminars } = await withProducts(direction);
const d = direction.data;
---

<BaseLayout title={d.title} description={d.lead ?? d.subtitle} fullBleed>
  <section class="program" aria-labelledby="direction-title">
    <PhotoBackdrop src={shelves} eager />
    <div class="scrim" aria-hidden="true"></div>
    <div class="container inner">
      <p class="back"><a href="/#obuchenie"><span aria-hidden="true">←</span> Обучение</a></p>

      <header class="head">
        <div class="titles">
          <h1 id="direction-title" lang="de">{d.title}</h1>
          {d.subtitle && <p class="subtitle">{d.subtitle}</p>}
          {d.status === 'active' && d.lead && <p class="lead">{d.lead}</p>}
        </div>
        <TrialVideoLink direction={direction} tone="dark" />
      </header>

      {
        d.status === 'active' ? (
          <ProductColumns courses={courses} seminars={seminars} title={d.formatsTitle} />
        ) : (
          <div class="prep-body">
            <p>{d.preparingText ?? 'Программа в подготовке'}</p>
          </div>
        )
      }
    </div>
  </section>

  <VideoPlaceholder direction={direction} />
</BaseLayout>

<style>
  .program {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(1.5rem, 1rem + 2vw, 3rem) var(--section-space);
    color: var(--color-parchment);
  }
  .scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--color-walnut) 55%, transparent) 0%, transparent 40%, transparent 75%, var(--color-walnut) 100%),
      color-mix(in srgb, var(--color-walnut) 35%, transparent);
  }
  .inner { display: grid; gap: clamp(1.5rem, 1rem + 2vw, 2.5rem); }
  .back { margin: 0; }
  .back a { color: var(--color-gold); text-decoration: none; display: inline-flex; gap: 0.4rem; min-height: 2.75rem; align-items: center; font-weight: var(--weight-medium); }
  .back a:hover { text-decoration: underline; }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .titles { display: grid; gap: 0.5rem; max-width: 46rem; }
  .titles h1 {
    margin: 0;
    font-size: var(--text-h1);
    font-weight: 560;
    line-height: var(--leading-h1);
    text-shadow: 0 2px 24px var(--color-walnut-deep);
  }
  .subtitle { margin: 0; color: var(--color-gold-light); font-size: var(--text-lead); font-weight: var(--weight-medium); }
  .lead { margin: 0; color: var(--color-parchment); max-width: 44ch; }

  .prep-body {
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-radius: calc(var(--radius) * 3);
    border: 1px solid var(--glass-border);
    background: color-mix(in srgb, var(--color-emerald) 60%, transparent);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
  }
  .prep-body p { margin: 0; font-family: var(--font-display); font-size: var(--text-h3); }
</style>
