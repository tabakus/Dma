---
/**
 * Место пробного видеоурока на странице подраздела (якорь #probeurok).
 * Пока видео нет — муляж плеера с подписью. Когда появится ссылка (directions.yaml → video.href),
 * здесь будет кнопка перехода к видео на площадке; встраивание плеера — только после решения по DSGVO.
 */
import type { Direction } from '../../lib/directions';

interface Props {
  direction: Direction;
}
const { video } = Astro.props.direction.data;
---

<section class="video" id="probeurok" aria-labelledby="probeurok-title">
  <div class="container">
    <h2 id="probeurok-title" class="title">{video.label}</h2>
    {
      video.href ? (
        <a class="frame ready" href={video.href} target="_blank" rel="noopener noreferrer">
          <span class="play" aria-hidden="true" />
          <span class="caption">Смотреть видеоурок <span class="visually-hidden">(откроется в новой вкладке)</span></span>
        </a>
      ) : (
        <div class="frame" role="img" aria-label={video.placeholder}>
          <span class="play" aria-hidden="true" />
          <span class="caption" aria-hidden="true">{video.placeholder}</span>
        </div>
      )
    }
  </div>
</section>

<style>
  .video { padding-block: clamp(1rem, 0.5rem + 2vw, 2.5rem) var(--section-space); scroll-margin-top: 4.5rem; }
  .title { margin: 0 0 var(--space-4); }
  .frame {
    position: relative;
    display: grid;
    place-items: center;
    align-content: center;
    gap: var(--space-3);
    aspect-ratio: 16 / 9;
    width: min(100%, 56rem);
    border-radius: calc(var(--radius) * 2);
    border: 1px solid var(--glass-border);
    background:
      radial-gradient(ellipse at 50% 45%, color-mix(in srgb, var(--color-gold) 22%, transparent), transparent 60%),
      radial-gradient(ellipse at 50% 50%, var(--color-emerald), var(--color-walnut-deep) 85%);
    box-shadow: 0 40px 70px -40px #000;
    color: var(--color-parchment);
    text-decoration: none;
    overflow: hidden;
  }
  .play {
    width: clamp(4rem, 3rem + 4vw, 6rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-accent);
    position: relative;
  }
  .play::after {
    content: '';
    position: absolute;
    left: 54%;
    top: 50%;
    translate: -50% -50%;
    border-style: solid;
    border-width: 0.9rem 0 0.9rem 1.5rem;
    border-color: transparent transparent transparent var(--color-ink);
  }
  .caption { font-weight: var(--weight-medium); color: var(--color-parchment); text-align: center; padding-inline: var(--space-3); }
  .ready:hover .play { transform: scale(1.05); }
</style>
