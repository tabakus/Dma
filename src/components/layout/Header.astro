---
/**
 * Шапка сайта (тёмная, полупрозрачная поверх фото): логотип для тёмного фона и слоган под ним (site.yaml → tagline), основное меню и заметная кнопка (site.yaml → nav, headerCta).
 * На узких экранах меню сворачивается в панель за кнопкой «Меню».
 * Без JavaScript меню остаётся раскрытым, чтобы все ссылки были доступны.
 */
import Logo from '../brand/Logo.astro';
import { getSiteSettings } from '../../lib/site';
import { sentences } from '../../lib/text';

const site = await getSiteSettings();
const current = Astro.url.pathname;

/** Активный пункт: точное совпадение для главной, по префиксу для разделов; якоря активными не считаются. */
const isCurrent = (href: string) => {
  if (href.includes('#')) return false;
  if (href === '/') return current === '/';
  return current.startsWith(href);
};
---

<header class="site-header" data-nav>
  <div class="container bar">
    <div class="brand">
      <Logo variant="dark" />
      {
        site.tagline && (
          <p class="tagline">
            {sentences(site.tagline).map((line, i) => (
              <>
                {i > 0 && ' '}
                <span>{line}</span>
              </>
            ))}
          </p>
        )
      }
    </div>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" data-nav-toggle hidden>
      <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
      <span>Меню</span>
    </button>
    <div class="menu" id="site-menu">
      <nav aria-label="Основная навигация">
        <ul>
          {
            site.nav.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      {site.headerCta && <a class="btn btn-primary cta" href={site.headerCta.href}>{site.headerCta.label}</a>}
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--color-walnut) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: 1px solid var(--color-line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 4.5rem;
  }
  .brand { display: grid; gap: 0.3rem; padding-block: 0.6rem; min-width: 0; flex: 0 1 auto; }
  .menu-toggle { flex: none; }
  /* слоган: в одну строку; на телефоне по предложению на строку, чтобы не сдвигать кнопку «Меню» */
  .tagline {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.3;
    letter-spacing: 0.01em;
    white-space: nowrap;
    color: var(--color-logo-light);
  }
  @media (max-width: 47.99rem) {
    .tagline { white-space: normal; }
    .tagline span { display: block; }
  }
  .menu {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }
  nav ul {
    display: flex;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: inline-block;
    padding-block: 0.4rem;
    color: var(--color-text);
    font-size: var(--text-ui);
    font-weight: var(--weight-medium);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: border-color 0.15s, color 0.15s;
  }
  nav a:hover { color: var(--color-link); }
  nav a[aria-current='page'] { color: var(--color-link); }
  nav a[aria-current='page'] { border-bottom-color: var(--color-accent); }
  .cta { white-space: nowrap; }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0 0.9rem;
    border: 1.5px solid var(--color-text);
    border-radius: var(--radius);
    background: transparent;
    color: var(--color-text);
    font: var(--weight-semibold) var(--text-ui) / 1 var(--font-body);
    cursor: pointer;
  }
  .menu-toggle[hidden] { display: none; }
  .menu-icon { display: grid; gap: 4px; width: 16px; }
  .menu-icon i { display: block; height: 2px; background: currentColor; border-radius: 1px; transition: transform 0.2s; }
  [aria-expanded='true'] .menu-icon i:first-child { transform: translateY(3px) rotate(45deg); }
  [aria-expanded='true'] .menu-icon i:last-child { transform: translateY(-3px) rotate(-45deg); }

  /* Узкие экраны: меню — выпадающая панель (только когда JavaScript включён и кнопка показана). */
  @media (max-width: 64rem) {
    .bar { flex-wrap: wrap; }
    .menu { flex-basis: 100%; flex-direction: column; align-items: stretch; gap: var(--space-4); padding-bottom: var(--space-4); }
    nav ul { flex-direction: column; gap: 0; }
    nav li + li { border-top: 1px solid var(--color-line); }
    nav a { display: block; padding-block: 0.9rem; font-size: 1.125rem; border-bottom: 0; }
    nav a[aria-current='page'] { color: var(--color-link); }
    .cta { align-self: stretch; }
    :global(.js) .site-header:not(.is-open) .menu { display: none; }
  }
  @media (min-width: 64.0625rem) {
    .menu-toggle { display: none !important; }
  }
</style>

<script>
  // Сворачиваемое меню на узких экранах. Без JS меню просто раскрыто.
  document.documentElement.classList.add('js');
  const header = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  if (header && toggle) {
    toggle.hidden = false;
    const setOpen = (open: boolean) => {
      header.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle.addEventListener('click', () => setOpen(!header.classList.contains('is-open')));
    // Переход по пункту меню (в т. ч. по якорю на этой же странице) закрывает панель.
    header.querySelectorAll('#site-menu a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
