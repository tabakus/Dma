---
/**
 * Подвал: логотип для тёмного фона, слоган, навигация. Контакты и юридические ссылки показываются,
 * только когда соответствующие данные есть (contactEmail в site.yaml, опубликованные страницы).
 */
import { getCollection } from 'astro:content';
import Logo from '../brand/Logo.astro';
import { getSiteSettings } from '../../lib/site';

const site = await getSiteSettings();
// Ссылки на информационные страницы показываются, только если страница опубликована.
const published = new Set((await getCollection('pages', (p) => p.data.status === 'published')).map((p) => `/${p.id}/`));
const legal = site.footerNav.filter((l) => published.has(l.href));
---

<footer class="site-footer">
  <div class="container inner">
    <div class="brand">
      <Logo variant="dark" />
      <p class="slogan" lang="de">Dein Deutsch. Dein Weg. <span>Dein Fortschritt.</span></p>
    </div>
    <nav aria-label="Навигация в подвале">
      <ul>
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    {
      site.contactEmail && (
        <div class="contact">
          <p class="label">Контакты</p>
          <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
        </div>
      )
    }
  </div>
  <div class="container base">
    <p class="copy">
      © {new Date().getFullYear()} {site.name}
      {
        site.footerNote && (
          <span class="note">
            <span class="flag-de" aria-hidden="true" />
            {site.footerNote}
          </span>
        )
      }
    </p>
    {
      legal.length > 0 && (
        <nav aria-label="Правовая информация">
          <ul>
            {legal.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-walnut-deep);
    color: var(--color-parchment);
    border-top: 1px solid var(--color-line);
    padding-block: clamp(3rem, 2rem + 4vw, 5rem) var(--space-4);
  }
  .inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr auto;
    gap: var(--space-5);
    align-items: start;
    padding-bottom: clamp(2.5rem, 2rem + 2vw, 4rem);
  }
  .brand { display: grid; gap: var(--space-4); justify-items: start; }
  .slogan {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    font-size: var(--text-h4);
    line-height: var(--leading-h4);
  }
  .slogan span { color: var(--color-accent); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.65rem; }
  a { color: var(--color-parchment); text-decoration: none; }
  a:hover { color: var(--color-gold); text-decoration: underline; }
  .label { margin: 0 0 0.5rem; font-size: var(--text-small); color: var(--color-gold); }
  .base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line);
    font-size: var(--text-caption);
    color: var(--color-sepia);
  }
  .base p { margin: 0; }
  .copy { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.5rem; }
  .note { display: inline-flex; align-items: center; gap: 0.6rem; }
  /* полоса цветов флага по верхнему краю подвала */
  .site-footer { position: relative; }
  .site-footer::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 6px; background: var(--flag-stripes-h); box-shadow: inset 0 1px 0 var(--flag-edge); }
  .base ul { display: flex; gap: var(--space-4); }
  @media (max-width: 48rem) {
    .inner { grid-template-columns: 1fr; gap: var(--space-4); }
  }
</style>
