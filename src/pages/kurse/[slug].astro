---
/**
 * Страница продукта. Генерируется для каждой опубликованной папки в src/content/courses/.
 * Архивные, черновые и анонсированные продукты страниц не получают. Оформление — src/components/product/ProductPage.astro.
 */
import ProductPage from '../../components/product/ProductPage.astro';
import { getPublishedCourses, type Product } from '../../lib/products';

export async function getStaticPaths() {
  const products = await getPublishedCourses();
  return products.map((product) => ({ params: { slug: product.id }, props: { product } }));
}

interface Props {
  product: Product;
}
---

<ProductPage product={Astro.props.product} />
